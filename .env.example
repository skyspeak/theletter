# dear[CC] The Letter + Game Plan (Vercel)
# Copy to .env.local — never commit secrets.
#
# One Neon DATABASE_URL for both features:
#   newsletter_subscribers  (The Letter enroll / weekly)
#   game_plans              (Game Plan analyze / waitlist)
# Do NOT create a second database for Game Plan.

DATABASE_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL="dear[CC] The Letter <onboarding@resend.dev>"
# RESEND_REPLY_TO_EMAIL=

BASE_URL=http://localhost:5174
FIELD_REPORT_URL=http://localhost:5173

# Comma-separated browser origins allowed to POST /api/subscribe (Field Report)
CORS_ORIGINS=http://localhost:5173,https://skyspeak.github.io

CRON_SECRET=

# Secret path for one-off test send: GET /api/test-letter/<TEST_LETTER_SECRET>
# Emails skyspeak@gmail.com (override with TEST_LETTER_TO). Once per minute.
TEST_LETTER_SECRET=
# TEST_LETTER_TO=skyspeak@gmail.com

# Weekly curation (StayRelevant-style prompt + source pools)
OPENROUTER_API_KEY=
# Free default: google/gemma-3-27b-it:free — override if that model is offline
# OPENROUTER_MODEL=google/gemma-3-27b-it:free
TAVILY_API_KEY=
# Optional Reddit OAuth for r/MachineLearning etc.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Optional Game Plan personalization (deterministic fallback without this)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Frontend link back to Field Report
VITE_FIELD_REPORT_URL=http://localhost:5173
